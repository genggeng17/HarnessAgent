{
  "schema_version": 1,
  "deepseek": {
    "base_url": "https://njusehub.info/v1",
    "model": "deepseek-v4-pro",
    "api_key_env": "NEW_API_KEY",
    "timeout_seconds": 180,
    "max_retries": 2
  },
  "validators": [
    {
      "id": "python_tests",
      "argv": ["python", "-m", "pytest"],
      "cwd": ".",
      "timeout_seconds": 60,
      "required": true
    }
  ],
  "loop_guard": {
    "max_iterations": 36,
    "max_tool_calls": 48,
    "max_reflections": 3,
    "repeated_action_limit": 3
  }
}
