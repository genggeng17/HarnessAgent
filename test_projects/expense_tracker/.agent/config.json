{
  "schema_version": 1,
  "validators": [
    {
      "id": "python_tests",
      "argv": ["python", "-m", "pytest"],
      "cwd": ".",
      "timeout_seconds": 60,
      "required": true
    }
  ],
  "loop_guard": {
    "max_iterations": 30,
    "max_tool_calls": 40,
    "max_reflections": 3,
    "repeated_action_limit": 3
  }
}
